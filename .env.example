# LabVIEW HTTP server base URL (no trailing slash)
# Example: http://192.168.1.100:8080
LABVIEW_BASE_URL=http://192.168.1.100:8080

# Secret key for signing JWT cookies (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret

# Server port
PORT=3000

# JWT session duration in hours (matches shift length)
SESSION_HOURS=8
